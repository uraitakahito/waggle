# waggle の環境変数。`./setup.sh` がこれを写して `.env` を作る。
#
# 空文字は「無い」と同じ意味に揃えてある (POSIX の ${VAR:-word} 側)。そのうえで
# **既定値を持つ変数が空で設定されていたら、起動時に落とす** —— 黙って既定値に
# 戻すと「既定値のままにしたつもりが無かった」誤りが見えなくなるため。
#
# したがってこのファイルの行は 2 種類しかない:
#
#   <NAME>=value    値を渡す
#   #<NAME>=value   既定値を見せるだけ (使うならコメントを外して値を書く)
#
# **生の空行 (NAME=) を書いてよいのは必須の変数だけ。** 必須の空は「不足」として
# 報告されるが、任意の空は既定値を潰すので落とされる。scripts/check-env.mjs が
# この規則を検査している。
#
# **`.env` の出どころはこのファイルだけ。** setup.sh は独自の一覧を持たず、
# ここを cp して WAGGLE_DEV_SUBJECT だけ実行者の名前に差し替える。
#
# **この一覧は scripts/check-env.mjs が見張っている。** src/ と scripts/ が
# 実際に読む変数とここが食い違うと CI が落ちる —— 古い雛形は、雛形が無いより
# 悪い。「これで全部だ」と信じて使うので、足りないときに理由の見当がつかなくなる。

# ── 接続先 ──────────────────────────────────────────────────────────
DATABASE_URL=postgres://waggle:waggle@postgres.waggle:5432/waggle
BROWSERHIVE_SERVER=browserhive.waggle:50051
# BrowserHive への gRPC を TLS にするときの CA 証明書のパス。開発のスタックは平文
# なので設定しない。**値が無いのでコメントのまま置く** (生の空行にはできない)。
#BROWSERHIVE_TLS_CA_CERT=

# ── 成果物ストア (S3) ───────────────────────────────────────────────
# host から叩くので publish されたポート。コンテナの中からなら
# seaweedfs.waggle:8333 になる。
WAGGLE_S3_ENDPOINT=http://127.0.0.1:8333
# waggle は BrowserHive が置いた成果物を読む側なので、名前は向こうに合わせる。
WAGGLE_S3_BUCKET=browserhive
WAGGLE_S3_ACCESS_KEY_ID=browserhive
WAGGLE_S3_SECRET_ACCESS_KEY=browserhive
# 同梱の SeaweedFS は bucket の subdomain 用のワイルドカード DNS を持たないので、
# virtual-hosted 形式の宛先は当たらない。
WAGGLE_S3_FORCE_PATH_STYLE=true
#WAGGLE_S3_REGION=us-east-1

# ── 認可 (OpenFGA) ──────────────────────────────────────────────────
# **この 2 つは `pnpm run fga:deploy` が出力した id を貼る。** 起動前には決まらない
# ので、setup.sh は空のまま残す。
# model id を固定するのは意図的で、省くと「そのとき最も新しいモデル」に対して
# 評価するので、モデルを編集した瞬間にすべての判断が変わる。
WAGGLE_FGA_STORE_ID=
WAGGLE_FGA_MODEL_ID=
#WAGGLE_FGA_API_URL=http://localhost:8090
#WAGGLE_FGA_API_TOKEN=dev-key
# scripts/fga-deploy.mjs が作る store の名前。
#WAGGLE_FGA_STORE_NAME=waxlens
# scripts/fga-migrate.mjs が使う。migrate は distroless なので別手順になっている。
#WAGGLE_FGA_IMAGE=docker.io/openfga/openfga:v1.10.2
#WAGGLE_FGA_DATASTORE_URI=

# ── 主体 (本物の IdP が来るまでの足場) ──────────────────────────────
# 検証は一切しない。書いた人がそのまま名乗れる。CLI 側 (pnpm run dev) が読む。
# setup.sh がこの行を実行者の名前で置き換える。
WAGGLE_DEV_SUBJECT=dev
# 生の行。**optional だが、無いと pnpm run dev が落ちる** —— seed の URL は
# どれも組織を持っていて、自分が属さない組織の URL は投げない検査があるため。
# 「型の上で任意かどうか」と「開発に要るかどうか」は別。
WAGGLE_DEV_ORGANIZATIONS=acme
# API 側。1 のとき X-Waggle-Subject をそのまま信じる。**未設定でも API は起動する**
# が、resolver が denyAll になるので一覧が常に 401 になる。picker が空に見える
# 原因はたいていこれ。
WAGGLE_DEV_IDENTITY=1

# ── その他 ──────────────────────────────────────────────────────────
# ログの量。trace / debug / info / warn / error / fatal。
LOG_LEVEL=info
# picker と API のポート。open http://127.0.0.1:7070/ で picker が開く。
WAGGLE_API_PORT=7070
#WAGGLE_DRAIN_INTERVAL_MS=
# picker が組み立てる replay の場所。replay は waggle 専用ではないので env にある。
# **既定値は「replay を同じ機械の 8899 で動かしている」前提。** 別の場所で動かすなら
# 必ず変える —— 間違っていても picker は開き、行をクリックした先で初めて分かる。
REPLAY_ORIGIN=http://127.0.0.1:8899
#MIGRATION_FOLDER=
#SEED_FOLDER=
